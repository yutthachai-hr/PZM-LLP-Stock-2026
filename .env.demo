# Loaded by `npm run demo` (vite --mode demo).
#
# Forces the app into local mode: src/firebase/config.ts returns no config, so the backend
# falls back to browser storage and never opens the live pzm-stock-x5 project. Nothing here
# is secret — it is committed so the demo build is reproducible from a fresh clone.
VITE_DEMO_MODE=1

# Sending order sheets through LINE (LIFF) needs a real HTTPS address, so it is off on
# localhost: the share button falls back to the device's share menu. On the `demo` branch
# deploy, set VITE_LIFF_ID, VITE_PO_IMAGE_DEMO_KEY and PO_IMAGE_DEMO_KEY in the Netlify UI
# for that context — never here, and never on production. See HANDOFF.md §6.0.
# VITE_LIFF_ID=
# VITE_PO_IMAGE_DEMO_KEY=
