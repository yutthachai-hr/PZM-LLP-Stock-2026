# Loaded by `npm run demo` (vite --mode demo).
#
# Forces the app into local mode: src/firebase/config.ts returns no config, so the backend
# falls back to browser storage and never opens the live pzm-stock-x5 project. Nothing here
# is secret — it is committed so the demo build is reproducible from a fresh clone.
VITE_DEMO_MODE=1

# Sending order sheets through LINE (LIFF) needs a real HTTPS address, so it is off on
# localhost: the share button falls back to the device's share menu. The `demo` branch
# deploys to demo.pzmstock.pages.dev: vite.config.ts turns demo mode on from the branch
# name, the LIFF id comes from src/share/lineLiffProvider.ts by hostname, and the two
# picture-host keys (VITE_PO_IMAGE_DEMO_KEY for the build, PO_IMAGE_DEMO_KEY for the
# function — the same random string) are Secrets on the Cloudflare project's Preview
# environment — never here, and never on production. See HANDOFF.md §8.
# VITE_PO_IMAGE_DEMO_KEY=
