rules_version = '2';

// Server-enforced access control for the stock database.
//
// The app also checks roles in the UI, but that only hides buttons: anyone can call the
// REST API with their own token. These rules are the part an attacker cannot skip, so they
// re-state every restriction rather than trusting the client.
//
// Deploy:  firebase deploy --only firestore:rules
// Test:    npm run test:rules

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------- identity ----

    function authed() {
      return request.auth != null;
    }

    function profilePath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    // A tombstone that outlives the profile. Removing someone deletes their profile, but
    // their Firebase Auth login still exists and could sign in again; this is what makes
    // the removal stick. Only an admin can lift it.
    function revoked(uid) {
      return exists(/databases/$(database)/documents/revokedUsers/$(uid));
    }

    // A signed-in account with no profile document has no access. Deleting a user relies
    // on that, and it is also the state a brand-new self-signed-up account sits in.
    // A revoked account is treated as having no profile even if the document is still there,
    // so revocation takes effect on the next request rather than on the next cleanup.
    function hasProfile() {
      return authed() && !revoked(request.auth.uid) && exists(profilePath());
    }

    function profile() {
      return get(profilePath()).data;
    }

    // Staff are created inactive and stay locked out until an admin approves them.
    function active() {
      return hasProfile() && profile().active == true;
    }

    function admin() {
      return active() && profile().role == 'admin';
    }

    // A หัวหน้า: reviews and approves purchase requests. Everything an admin may do to a
    // request a manager may do too; the catalogue and the roster stay admin-only.
    function manager() {
      return active() && profile().role in ['admin', 'manager'];
    }

    // The same two questions asked from inside an edit rule, where writer() has already
    // proved the caller active. Re-proving it costs a profile lookup and a few dozen of the
    // 1,000 expressions a request may evaluate, which the widest documents cannot spare.
    // Only for use under `allow update`, after writer().
    function roleIsAdmin() {
      return profile().role == 'admin';
    }

    function roleIsManager() {
      return profile().role in ['admin', 'manager'];
    }

    // ---------------------------------------------------------------- brands ----

    // Each brand owns a namespace: "products" for Pizza Mania, "lelapin__products" for
    // Le Lapin. Permissions are per collection kind, so both spellings are listed here in
    // full. They used to be derived by splitting the name on "__", which quietly let
    // "lelapin__stockLevels__unregistered" read as "stockLevels" and inherit everything
    // staff may do to a balance. A new brand has to be added to both lists.

    // Recording stock is the everyday job, so any active user may write these.
    function staffWritable(name) {
      return name in [
        'stockMovements', 'stockLevels', 'counters', 'movementImages', 'notes',
        'stockEvents', 'purchaseOrders', 'purchaseBatches', 'productAliases',
        'purchaseRequests',
        'lelapin__stockMovements', 'lelapin__stockLevels', 'lelapin__counters',
        'lelapin__movementImages', 'lelapin__notes',
        'lelapin__stockEvents', 'lelapin__purchaseOrders',
        'lelapin__purchaseBatches', 'lelapin__productAliases',
        'lelapin__purchaseRequests'
      ];
    }

    // The catalogue and the shape of the warehouse are admin decisions.
    function adminWritable(name) {
      return name in [
        'products', 'productImages', 'locations', 'productMinOverrides',
        'suppliers', 'supplierItems',
        'lelapin__products', 'lelapin__productImages', 'lelapin__locations',
        'lelapin__productMinOverrides',
        'lelapin__suppliers', 'lelapin__supplierItems'
      ];
    }

    function brandData(name) {
      return staffWritable(name) || adminWritable(name);
    }

    // Which kind of record this is, brand aside. Only ever reached for a name that already
    // matched one of the exact lists above, so the split cannot be used to invent a kind.
    //
    // Call it once per function and bind the result with `let`: a rules request may evaluate
    // at most 1,000 expressions, and the dispatchers below used to re-run this regex for
    // every branch — a purchase request with a note (one more optional field to check)
    // went over the budget and was refused as "insufficient permissions" (17 Sep 2026).
    function kind(name) {
      return name.matches('^lelapin__.*') ? name.split('__')[1] : name;
    }

    // Movements are the ledger every balance is rebuilt from, so they are append-only for
    // everyone, admins included. Voiding and editing are updates that keep the original
    // row, and nothing in the app deletes one.
    function ledger(name) {
      return kind(name) == 'stockMovements';
    }

    // Notes are the only thing staff throw away. Clearing balances and images happens
    // when an admin deletes a product or a location.
    /**
     * An order whose goods reached the books.
     *
     * It is the paperwork behind a stock receipt, and nobody can delete a receipt. Deleting
     * the order would leave that movement with nothing explaining where it came from, so it
     * is as permanent as the movement it produced — admins included.
     */
    function receivedOrder(name) {
      return kind(name) == 'purchaseOrders' && resource.data.status == 'received';
    }

    function staffDeletable(name) {
      // An order that has been received is a record of goods that moved, so it stays. The
      // service refuses it too; this is the half that a caller with a token cannot skip.
      return kind(name) == 'notes'
        // A confirmed spelling that turns out wrong is unlearned by deleting it.
        || kind(name) == 'productAliases'
        || (kind(name) == 'purchaseOrders' && resource.data.status != 'received');
    }

    // ---------------------------------------------------------------- values ----

    // Firestore stores NaN and Infinity as ordinary doubles, so `is number` lets both
    // through. Every comparison with NaN is false and Infinity fails any finite upper
    // bound, so a bounded range is what actually rejects them.
    function positive(v, hi) {
      return v is number && v > 0 && v <= hi;
    }

    function nonneg(v, hi) {
      return v is number && v >= 0 && v <= hi;
    }

    // A plausible ms epoch: 1970 to 2100. Keeps a typo or a bad import out of the dates
    // that reports and the ledger window sort by.
    function epochMs(v) {
      return nonneg(v, 4102444800000);
    }

    function text(v, maxLen) {
      return v is string && v.size() <= maxLen;
    }

    // ---------------------------------------------------------------- schemas ----

    function movementCore(d) {
      return d.keys().hasAll([
          'id', 'docNo', 'type', 'productId', 'productName', 'unit', 'qty',
          'date', 'byUserId', 'byUserName', 'createdAt'
        ])
        && d.keys().hasOnly([
          'id', 'docNo', 'type', 'productId', 'productName', 'unit', 'entryUnit', 'qty',
          'fromLocationId', 'toLocationId', 'note', 'reason', 'hasPhoto',
          'date', 'byUserId', 'byUserName', 'createdAt',
          'edits', 'updatedBy', 'updatedByName', 'updatedAt', 'voided'
        ])
        && d.type in ['receive', 'issue', 'adjust', 'consume']
        && text(d.docNo, 40) && text(d.productId, 200) && text(d.productName, 300)
        && text(d.unit, 40) && text(d.byUserId, 200) && text(d.byUserName, 200)
        && positive(d.qty, 1000000000)
        && epochMs(d.date) && epochMs(d.createdAt)
        // Present only when the person keyed a unit other than the product's own. Nothing
        // is converted between the two; this is what the row is counted in.
        && (!('entryUnit' in d) || text(d.entryUnit, 20))
        // Appended by editMovement, one entry per correction. Rules cannot look inside a
        // list's maps, so the guarantees that matter are made on update: see appendedOwnEdit.
        && (!('edits' in d) || (d.edits is list && d.edits.size() <= 200))
        && (!('note' in d) || text(d.note, 2000))
        && (!('reason' in d) || text(d.reason, 60))
        && (!('hasPhoto' in d) || d.hasPhoto is bool)
        && (!('voided' in d) || d.voided is bool)
        && (!('fromLocationId' in d) || text(d.fromLocationId, 200))
        && (!('toLocationId' in d) || text(d.toLocationId, 200))
        && (!('updatedBy' in d) || text(d.updatedBy, 200))
        && (!('updatedByName' in d) || text(d.updatedByName, 200))
        && (!('updatedAt' in d) || epochMs(d.updatedAt));
    }

    function validLevel(d) {
      return d.keys().hasAll(['id', 'productId', 'locationId', 'qty', 'updatedAt', 'updatedBy'])
        // `unit` is present only on a balance counted in something other than the product's
        // own unit, so rows written before units were selectable still validate unchanged.
        && d.keys().hasOnly(['id', 'productId', 'locationId', 'unit', 'qty', 'updatedAt', 'updatedBy'])
        && (!('unit' in d) || text(d.unit, 20))
        && text(d.productId, 200) && text(d.locationId, 200)
        && nonneg(d.qty, 1000000000)
        && epochMs(d.updatedAt)
        // Balances are the one thing these rules cannot prove correct. That needs a trusted
        // server checking each write against the ledger, and the free plan has no room for
        // one. What they can do is make every balance write carry the name of whoever made
        // it, so drift the integrity check finds has an author instead of a shrug.
        && d.updatedBy == request.auth.uid;
    }

    function validCounter(d) {
      return d.keys().hasAll(['id', 'value'])
        && d.keys().hasOnly(['id', 'value'])
        && d.value is int
        && d.value >= 0
        && d.value <= 100000000;
    }

    function validProduct(d) {
      return d.keys().hasAll([
          'id', 'sku', 'name', 'category', 'unit', 'unitType', 'minStock',
          'hasImage', 'active', 'createdAt', 'updatedAt'
        ])
        && d.keys().hasOnly([
          'id', 'sku', 'name', 'category', 'unit', 'unitType', 'minStock', 'cost',
          'unitConversions', 'supplierId', 'alternateSupplierIds',
          'hasImage', 'active', 'createdAt', 'updatedAt'
        ])
        && text(d.sku, 100) && text(d.name, 300) && text(d.category, 100)
        && text(d.unit, 60) && text(d.unitType, 20)
        && nonneg(d.minStock, 1000000000)
        && (!('cost' in d) || nonneg(d.cost, 1000000000))
        // Who we buy it from. Absent on a product whose name never named anyone.
        && (!('supplierId' in d) || text(d.supplierId, 200))
        // Reference multipliers shown beside the quantity box — see the field's own
        // comment in types.ts for why nothing here ever converts a ledger entry. Bounded
        // like every other list in this file; not validated element by element, the same
        // as an order's lines.
        && (!('unitConversions' in d) || (d.unitConversions is list && d.unitConversions.size() <= 20))
        // Other suppliers it can come from, for a person to pick when the usual one is out.
        // The automatic order never chooses one of these by itself.
        && (!('alternateSupplierIds' in d)
            || (d.alternateSupplierIds is list && d.alternateSupplierIds.size() <= 10))
        && d.hasImage is bool && d.active is bool
        && epochMs(d.createdAt) && epochMs(d.updatedAt);
    }

    function validLocation(d) {
      return d.keys().hasAll(['id', 'name', 'type', 'active', 'createdAt'])
        && d.keys().hasOnly(['id', 'name', 'type', 'active', 'createdAt'])
        && text(d.name, 200)
        && d.type in ['warehouse', 'branch']
        && d.active is bool
        && epochMs(d.createdAt);
    }

    function validNote(d) {
      return d.keys().hasAll(['id', 'title', 'body', 'byUserName', 'pinned', 'createdAt', 'updatedAt'])
        && d.keys().hasOnly(['id', 'title', 'body', 'byUserName', 'pinned', 'createdAt', 'updatedAt'])
        && text(d.title, 300) && text(d.body, 20000) && text(d.byUserName, 200)
        && d.pinned is bool
        && epochMs(d.createdAt) && epochMs(d.updatedAt);
    }

    // Photos live in Firestore as base64 because Cloud Storage left the free plan in
    // February 2026. A document is capped at 1 MiB, so an oversized one fails on write
    // anyway; stating the limit makes it deliberate rather than incidental.
    function validImage(d) {
      return d.keys().hasAll(['id', 'dataUrl'])
        && d.keys().hasOnly(['id', 'dataUrl'])
        && d.dataUrl is string
        && d.dataUrl.size() <= 900000;
    }

    function validMinOverride(d) {
      return d.keys().hasAll(['id', 'productId', 'locationId', 'minStock'])
        && d.keys().hasOnly(['id', 'productId', 'locationId', 'minStock'])
        && text(d.productId, 200) && text(d.locationId, 200)
        && nonneg(d.minStock, 1000000000);
    }

    // Who we buy from. What they sell us is supplierItems, not a field here — the same
    // supplier sells several things, and one product per supplier cannot say that.
    function validSupplier(d) {
      return d.keys().hasAll(['id', 'name', 'contactNumber', 'email', 'type', 'active',
          'createdAt', 'updatedAt'])
        && d.keys().hasOnly(['id', 'name', 'contactNumber', 'email', 'type', 'note',
          'defaultLocationId', 'leadTimeDays', 'orderDays', 'cutoffTime',
          'active', 'createdAt', 'updatedAt'])
        && text(d.name, 200)
        && d.contactNumber is string && d.contactNumber.size() <= 40
        && d.email is string && d.email.size() <= 200
        && d.type in ['takingReturn', 'notTakingReturn']
        && d.active is bool
        && epochMs(d.createdAt) && epochMs(d.updatedAt)
        && (!('note' in d) || d.note is string && d.note.size() <= 2000)
        // Where this supplier's goods usually land, and how many days they take. Both are
        // defaults the automatic order offers; neither is a rule it enforces.
        && (!('defaultLocationId' in d) || text(d.defaultLocationId, 200))
        && (!('leadTimeDays' in d) || nonneg(d.leadTimeDays, 365))
        // Which weekdays (0 = Sunday) an order may be placed, and the time of day it has to
        // be in by. The calendar shows them as cut-offs; nothing refuses an order after one.
        && (!('orderDays' in d) || (d.orderDays is list && d.orderDays.size() <= 7))
        && (!('cutoffTime' in d) || text(d.cutoffTime, 5));
    }

    // A planned piece of work: a count, an audit, an expected delivery, a task.
    //
    // Low stock is deliberately NOT one of these. It is already derived for free from
    // balances the app holds in memory, and one document per low product per location
    // would be over a thousand documents that then have to be cleared again.
    function validEvent(d) {
      return d.keys().hasAll(['id', 'title', 'type', 'startAt', 'status', 'priority',
          'createdBy', 'createdAt', 'updatedAt'])
        && d.keys().hasOnly(['id', 'title', 'type', 'locationId', 'startAt', 'dueAt',
          'status', 'priority', 'assignedTo', 'assignedToAll', 'assignedToName', 'note',
          'createdBy', 'createdAt', 'updatedAt'])
        && text(d.title, 300)
        && d.type in ['stockCount', 'audit', 'delivery', 'transfer', 'inventoryTask', 'other']
        && d.status in ['upcoming', 'inProgress', 'completed', 'cancelled']
        && d.priority in ['normal', 'high', 'critical']
        && epochMs(d.startAt) && epochMs(d.createdAt) && epochMs(d.updatedAt)
        && text(d.createdBy, 200)
        && (!('locationId' in d) || text(d.locationId, 200))
        && (!('dueAt' in d) || epochMs(d.dueAt) && d.dueAt >= d.startAt)
        // Who it is for: a list of uids, or — for events written before the list — one uid
        // as a string. Everyone is the flag, not a list of every uid.
        && (!('assignedTo' in d) || text(d.assignedTo, 200)
            || (d.assignedTo is list && d.assignedTo.size() >= 1 && d.assignedTo.size() <= 50))
        && (!('assignedToAll' in d) || d.assignedToAll is bool)
        && (!('assignedToName' in d) || text(d.assignedToName, 1000))
        && (!('note' in d) || d.note is string && d.note.size() <= 2000)
        // Where this supplier's goods usually land, and how many days they take. Both are
        // defaults the automatic order offers; neither is a rule it enforces.
        && (!('defaultLocationId' in d) || text(d.defaultLocationId, 200))
        && (!('leadTimeDays' in d) || nonneg(d.leadTimeDays, 365));
    }

    // Staff may move an event along and nothing else. Without this the catch-all lets any
    // active user replace a whole document via set(), rewriting who created it and when.
    function eventEdit() {
      return admin() || (
        editedKeys().hasOnly(['status', 'updatedAt'])
        && request.resource.data.createdBy == resource.data.createdBy
      );
    }

    // One product a supplier sells us. buyingPrice is optional: it is not always known,
    // and a zero would read as free rather than as unknown.
    function validSupplierItem(d) {
      return d.keys().hasAll(['id', 'supplierId', 'productId', 'active', 'createdAt',
          'updatedAt'])
        && d.keys().hasOnly(['id', 'supplierId', 'productId', 'buyingPrice', 'minOrderQty',
          'active', 'createdAt', 'updatedAt'])
        && text(d.supplierId, 200) && text(d.productId, 200)
        && d.active is bool
        && epochMs(d.createdAt) && epochMs(d.updatedAt)
        && (!('buyingPrice' in d) || nonneg(d.buyingPrice, 1000000000))
        // The least the supplier will sell at once. A warning on the order review, not a
        // block: the person may know the supplier is making an exception.
        && (!('minOrderQty' in d) || positive(d.minOrderQty, 1000000000));
    }

    // Rules cannot walk a list, so each name's own length is enforced by the service and by
    // the editor's maxLength. What is pinned here is what protects the database: the exact
    // key set, the id, and a bound on how many names a single write may add.
    function validUnitList(d) {
      return d.keys().hasOnly(['id', 'names', 'updatedAt'])
        && d.id == 'entryUnits'
        && d.names is list
        && d.names.size() > 0
        && d.names.size() <= 40
        && d.updatedAt is number;
    }

    /**
     * An order placed with a supplier.
     *
     * Staff place and receive orders, which is why this is in the staff list — ordering is
     * the everyday job, same as recording stock. What staff cannot do is make the stock move
     * without a receipt: taking an order into stock writes an ordinary stockMovement, and
     * that document is validated by the same rules as any other.
     *
     * The lines are a list, and rules cannot look inside one, so what is pinned here is the
     * shape around them and a bound on how many. The quantities inside are checked by the
     * service and, where it matters, by the movement the receipt produces.
     */
    function validPurchaseOrder(d) {
      return orderFrozen(d) && orderLive(d) && d.keys().hasAll([
          'id', 'docNo', 'supplierId', 'supplierName', 'status', 'locationId',
          'orderedAt', 'lines', 'createdBy', 'createdByName', 'createdAt', 'updatedAt'
        ])
        && d.keys().hasOnly([
          'id', 'docNo', 'supplierId', 'supplierName', 'status', 'locationId',
          'orderedAt', 'expectedAt', 'lines', 'invoiceNo', 'receivedAt', 'receivedBy', 'receivedByName',
          'movementDocNo', 'eventId', 'note',
          'batchId', 'requestId', 'approvedBy', 'approvedByName', 'approvedAt',
          'shareStatus', 'shareOpenedAt', 'sentAt', 'sentBy', 'sentByName', 'imageVersion',
          'createdBy', 'createdByName', 'createdAt', 'updatedAt'
        ]);
    }

    /** What an order IS — checked when it is placed; orderEdit() keeps it from moving. */
    function orderFrozen(d) {
      return text(d.docNo, 40) && text(d.supplierId, 200) && text(d.supplierName, 300)
        && text(d.locationId, 200)
        && text(d.createdBy, 200) && text(d.createdByName, 200) && epochMs(d.createdAt)
        // Where it came from: the calendar event, the imported list, the request.
        && (!('eventId' in d) || text(d.eventId, 200))
        && (!('batchId' in d) || text(d.batchId, 200))
        && (!('requestId' in d) || text(d.requestId, 200));
    }

    /**
     * What may still change — checked on every write, and the whole check on update (see
     * validShape: a received order that came through a request and went out by LINE
     * carries every optional field, and checking all of them again went over the
     * expression budget).
     */
    function orderLive(d) {
      return d.status in ['draft', 'ordered', 'received']
        && epochMs(d.orderedAt) && epochMs(d.updatedAt)
        // When the supplier is to deliver — the day the order asked for, or the lead time
        // counted from the order. The calendar's receiving entries hang off it.
        && (!('expectedAt' in d) || epochMs(d.expectedAt))
        && d.lines is list && d.lines.size() > 0 && d.lines.size() <= 200
        && (!('invoiceNo' in d) || text(d.invoiceNo, 100))
        && (!('note' in d) || text(d.note, 2000))
        && (!('movementDocNo' in d) || text(d.movementDocNo, 40))
        && (!('receivedAt' in d) || epochMs(d.receivedAt))
        && (!('receivedBy' in d) || text(d.receivedBy, 200))
        && (!('receivedByName' in d) || text(d.receivedByName, 200))
        // From an imported list or a request: a draft until approved, and the approval is signed.
        && (!('approvedBy' in d) || text(d.approvedBy, 200))
        && (!('approvedByName' in d) || text(d.approvedByName, 200))
        && (!('approvedAt' in d) || epochMs(d.approvedAt))
        // Where the sheet has got to on its way to the supplier. `sent` is what LINE
        // reported, not what the supplier has read — see the type's comment.
        && (!('shareStatus' in d) || d.shareStatus in ['shareOpened', 'sent', 'skipped', 'failed'])
        && (!('shareOpenedAt' in d) || epochMs(d.shareOpenedAt))
        && (!('sentAt' in d) || epochMs(d.sentAt))
        && (!('sentBy' in d) || text(d.sentBy, 200))
        && (!('sentByName' in d) || text(d.sentByName, 200))
        && (!('imageVersion' in d) || nonneg(d.imageVersion, 1000000))
        // An order that reached the books names the paper it came with. Without this the
        // invoice number is a habit the form could be talked out of.
        && (d.status != 'received' || ('invoiceNo' in d && 'movementDocNo' in d));
    }

    /**
     * One import of the order workbook. The rows and groups are lists the rules cannot walk,
     * so what is pinned is the shape around them and a bound on how many; what each row says
     * is checked by the service and, in the end, by the order it becomes — which is validated
     * like any other order.
     */
    function validBatch(d) {
      return d.keys().hasAll([
          'id', 'batchNo', 'locationId', 'sourceFileName', 'fileHash', 'sheetName',
          'blockLabel', 'status', 'rows', 'groups', 'history',
          'createdBy', 'createdByName', 'createdAt', 'updatedAt'
        ])
        && d.keys().hasOnly([
          'id', 'batchNo', 'locationId', 'sourceFileName', 'fileHash', 'sheetName',
          'blockLabel', 'blockDate', 'mapping', 'status', 'rows', 'groups', 'history',
          'createdBy', 'createdByName', 'createdAt', 'updatedAt'
        ])
        && text(d.batchNo, 40) && text(d.locationId, 200) && text(d.sourceFileName, 200)
        && text(d.fileHash, 128) && text(d.sheetName, 200) && text(d.blockLabel, 200)
        && d.status in ['draft', 'needsReview', 'ready', 'approved', 'sending', 'completed', 'cancelled']
        && d.rows is list && d.rows.size() > 0 && d.rows.size() <= 300
        && d.groups is list && d.groups.size() <= 60
        && d.history is list && d.history.size() > 0 && d.history.size() <= 500
        && (!('blockDate' in d) || epochMs(d.blockDate))
        && (!('mapping' in d) || d.mapping is map)
        && text(d.createdBy, 200) && text(d.createdByName, 200)
        && epochMs(d.createdAt) && epochMs(d.updatedAt);
    }

    /**
     * A purchase request: what was asked for, what the หัวหน้า approved, and the orders it
     * became. Lines and history are lists the rules cannot walk; the service checks what
     * each line says, and the orders a request turns into are validated as orders.
     */
    function validRequest(d) {
      return requestFrozen(d) && requestLive(d) && d.keys().hasAll([
          'id', 'docNo', 'status', 'revision', 'locationId', 'items', 'requestedBy',
          'requestedByName', 'history', 'createdBy', 'createdByName', 'createdAt', 'updatedAt'
        ])
        && d.keys().hasOnly([
          'id', 'docNo', 'status', 'revision', 'locationId', 'note', 'items',
          'requestedBy', 'requestedByName', 'submittedAt',
          'returnReason', 'rejectReason', 'approvalNote',
          'approvedBy', 'approvedByName', 'approvedAt',
          'rejectedBy', 'rejectedByName', 'rejectedAt',
          'orders', 'history', 'createdBy', 'createdByName', 'createdAt', 'updatedAt'
        ]);
    }

    /** The part of a request an edit may not touch — checked when it is filed. */
    function requestFrozen(d) {
      return text(d.docNo, 40)
        && text(d.requestedBy, 200) && text(d.requestedByName, 200)
        && text(d.createdBy, 200) && text(d.createdByName, 200)
        && epochMs(d.createdAt);
    }

    /**
     * The part an edit may change — checked on every write. On update this is the whole
     * check (see validShape); requestEdit() is what keeps the frozen part frozen and the
     * key set closed, so hasAll/hasOnly need not be paid for again.
     */
    function validRequestEdit(d) {
      return requestLive(d);
    }

    function requestLive(d) {
      return text(d.locationId, 200)
        && d.status in ['draft', 'pendingApproval', 'returned', 'approved', 'rejected', 'poCreated']
        && d.revision is int && d.revision >= 1 && d.revision <= 1000
        && d.items is list && d.items.size() <= 200
        && d.history is list && d.history.size() > 0 && d.history.size() <= 500
        && (!('orders' in d) || (d.orders is list && d.orders.size() <= 60))
        && (!('note' in d) || text(d.note, 2000))
        && (!('submittedAt' in d) || epochMs(d.submittedAt))
        && (!('returnReason' in d) || text(d.returnReason, 2000))
        && (!('rejectReason' in d) || text(d.rejectReason, 2000))
        && (!('approvalNote' in d) || text(d.approvalNote, 2000))
        && (!('approvedBy' in d) || text(d.approvedBy, 200))
        && (!('approvedByName' in d) || text(d.approvedByName, 200))
        && (!('approvedAt' in d) || epochMs(d.approvedAt))
        && (!('rejectedBy' in d) || text(d.rejectedBy, 200))
        && (!('rejectedByName' in d) || text(d.rejectedByName, 200))
        && (!('rejectedAt' in d) || epochMs(d.rejectedAt))
        && epochMs(d.updatedAt)
        // What a status means is pinned to who signed it.
        && (d.status != 'approved' || 'approvedBy' in d)
        && (d.status != 'rejected' || 'rejectedBy' in d)
        && (d.status != 'poCreated' || ('orders' in d && d.orders.size() > 0));
    }

    /** A workbook spelling somebody confirmed as one product. */
    function validAlias(d) {
      return d.keys().hasAll(['id', 'key', 'productId', 'sourceName', 'createdBy', 'createdByName', 'createdAt'])
        && d.keys().hasOnly(['id', 'key', 'productId', 'sourceName', 'createdBy', 'createdByName', 'createdAt'])
        && text(d.key, 300) && text(d.productId, 200) && text(d.sourceName, 300)
        && text(d.createdBy, 200) && text(d.createdByName, 200)
        && epochMs(d.createdAt);
    }

    // A document whose `id` field disagrees with its key makes the UI act on one row while
    // writing to another, so the two are pinned together here rather than hoped for.
    //
    // `fresh` is true on create. A purchase request is the widest document here — some
    // forty typed fields — and checking all of them on every update, on top of the edit
    // rules, ran past Firestore's budget of 1,000 evaluated expressions per request; the
    // write was refused as "insufficient permissions" (17 Sep 2026). On update only the
    // fields an edit may touch are re-checked; the frozen ones were checked at birth and
    // requestEdit() keeps them frozen. The heavy documents also sit early in the chain,
    // because every comparison walked past costs a few expressions.
    function validShape(name, docId, d, fresh) {
      let k = kind(name);
      return d.id == docId && (
        k == 'stockMovements' ? movementCore(d)
        : k == 'stockLevels' ? validLevel(d)
        : k == 'purchaseRequests' ? (fresh ? validRequest(d) : validRequestEdit(d))
        : k == 'purchaseOrders' ? (fresh ? validPurchaseOrder(d) : orderLive(d))
        : k == 'counters' ? validCounter(d)
        : k == 'products' ? validProduct(d)
        : k == 'locations' ? validLocation(d)
        : k == 'notes' ? validNote(d)
        : k == 'productMinOverrides' ? validMinOverride(d)
        : k == 'stockEvents' ? validEvent(d)
        : k == 'suppliers' ? validSupplier(d)
        : k == 'supplierItems' ? validSupplierItem(d)
        : k == 'purchaseBatches' ? validBatch(d)
        : k == 'productAliases' ? validAlias(d)
        : validImage(d)
      );
    }

    function writer(name) {
      return (active() && staffWritable(name)) || (admin() && adminWritable(name));
    }

    function editedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // A new movement is filed under whoever is filing it, and is not born already voided
    // or already corrected. Without the first check, staff can record stock in a
    // colleague's name and the ledger's "who" column means nothing.
    function createdHonestly(name) {
      let k = kind(name);
      return k == 'stockEvents'
        ? admin() && request.resource.data.createdBy == request.auth.uid
        // An order is filed by whoever placed it. Ordering is everyday work, so staff may do
        // it, but not in a colleague's name — the dashboard's "who ordered this" has to mean
        // something when the goods do not turn up.
        : k == 'purchaseOrders'
        ? request.resource.data.createdBy == request.auth.uid
          && request.resource.data.status != 'received'
        // An import is filed by whoever imported it, and is not born approved or sent.
        : k == 'purchaseBatches'
        ? request.resource.data.createdBy == request.auth.uid
          && request.resource.data.status in ['draft', 'needsReview', 'ready']
        : k == 'productAliases'
        ? request.resource.data.createdBy == request.auth.uid
        // A request is filed by whoever is asking, as a draft.
        : k == 'purchaseRequests'
        ? request.resource.data.createdBy == request.auth.uid
          && request.resource.data.requestedBy == request.auth.uid
          && request.resource.data.status == 'draft'
        : k != 'stockMovements' || (
          request.resource.data.byUserId == request.auth.uid
          && !('voided' in request.resource.data)
          && !('updatedBy' in request.resource.data)
        );
    }

    // Editing a movement means correcting the quantity, the business date or the note —
    // the things a person genuinely gets wrong. What the movement WAS stays put: its kind,
    // product, locations, document number, author, and the moment it was recorded. Listing
    // the fields that may move is what makes replacing the whole row with setDoc equivalent
    // to editing it, instead of a way around the freeze.
    //
    // Counters only ever go forwards, so a replayed or forged write cannot hand out a
    // document number that has already been used.
    function editedHonestly(name) {
      let k = kind(name);
      return k == 'purchaseOrders' ? orderEdit()
        : k == 'purchaseBatches' ? batchEdit()
        : k == 'purchaseRequests' ? requestEdit()
        // Confirming a spelling again replaces the whole alias, signed by whoever did it.
        : k == 'productAliases'
        ? request.resource.data.createdBy == request.auth.uid
        : k == 'stockMovements' ? movementEdit()
        : k == 'stockEvents' ? eventEdit()
        : k == 'counters' ? request.resource.data.value > resource.data.value
        : true;
    }

    /**
     * What may change on an order after it is placed.
     *
     * Not who placed it, not its number, not the supplier or the destination — those are what
     * the order IS, and an order whose supplier can be swapped after the fact is not evidence
     * of anything. Receiving fills in the arrival fields and rewrites the lines with what
     * actually turned up; both are the same edit and both are listed here.
     */
    function orderEdit() {
      return editedKeys().hasOnly([
          'status', 'lines', 'invoiceNo', 'note', 'docNo', 'expectedAt',
          'receivedAt', 'receivedBy', 'receivedByName', 'movementDocNo', 'updatedAt',
          // Approving a draft resets the order date and signs it; sending records where
          // the sheet got to. Neither may be signed in someone else's name.
          'orderedAt', 'approvedBy', 'approvedByName', 'approvedAt',
          'shareStatus', 'shareOpenedAt', 'sentAt', 'sentBy', 'sentByName', 'imageVersion'
        ])
        // The order date only moves when a draft is placed.
        && (!editedKeys().hasAny(['orderedAt']) || resource.data.status == 'draft')
        && (!('approvedBy' in request.resource.data)
            || request.resource.data.approvedBy == request.auth.uid
            || request.resource.data.approvedBy == resource.data.approvedBy)
        && (!('sentBy' in request.resource.data)
            || request.resource.data.sentBy == request.auth.uid
            || request.resource.data.sentBy == resource.data.sentBy)
        && request.resource.data.createdBy == resource.data.createdBy
        // A number is frozen for everyone but an admin putting the sequence right — the
        // owner's rule is that each supplier's orders count 1, 2, 3 in their own order,
        // and the orders numbered under the old shared counter had to be corrected.
        && (request.resource.data.docNo == resource.data.docNo || roleIsAdmin())
        && request.resource.data.supplierId == resource.data.supplierId
        && request.resource.data.locationId == resource.data.locationId
        // Whoever checked the delivery in signs for it. Once signed it stays as it is, and
        // the order may still be touched by others — an admin putting the numbers right,
        // say. (Until 17 Sep 2026 this read "receivedBy must be the caller" outright, which
        // locked every received order to the person who received it.)
        && (!('receivedBy' in request.resource.data)
            || request.resource.data.receivedBy == resource.data.receivedBy
            || request.resource.data.receivedBy == request.auth.uid);
    }

    /**
     * What may change on an import after it is filed: the rows as people settle them, the
     * groups and status as that happens, and the history — which only ever grows. Where it
     * came from and who filed it are what the batch IS.
     */
    function batchEdit() {
      return editedKeys().hasOnly(['rows', 'groups', 'history', 'status', 'updatedAt'])
        && request.resource.data.history.size() >= resource.data.history.size();
    }

    /**
     * What may change on a request, and who may change it.
     *
     * Its number, who asked, and when it was filed are what the request IS. The history
     * only grows. The lines may be rewritten by anyone who may write at all — a token
     * holder could forge a line either way, and what protects the business is that the
     * words that make a request an order (approved / rejected / returned / poCreated) may
     * only be spoken by a manager, in their own name, and a manager may not un-say them:
     * leaving approved or rejected takes an admin.
     */
    function requestEdit() {
      return editedKeys().hasOnly([
          'status', 'revision', 'locationId', 'note', 'items', 'submittedAt',
          'returnReason', 'rejectReason', 'approvalNote',
          'approvedBy', 'approvedByName', 'approvedAt',
          'rejectedBy', 'rejectedByName', 'rejectedAt',
          'orders', 'history', 'updatedAt'
        ])
        && request.resource.data.history.size() >= resource.data.history.size()
        && (request.resource.data.status == resource.data.status || requestMove())
        && (!('approvedBy' in request.resource.data)
            || request.resource.data.approvedBy == resource.data.approvedBy
            || request.resource.data.approvedBy == request.auth.uid)
        && (!('rejectedBy' in request.resource.data)
            || request.resource.data.rejectedBy == resource.data.rejectedBy
            || request.resource.data.rejectedBy == request.auth.uid);
    }

    function requestMove() {
      let from = resource.data.status;
      let to = request.resource.data.status;
      return (
        // submit / resubmit: the requester or a manager
        (to == 'pendingApproval' && from in ['draft', 'returned']
          && (resource.data.requestedBy == request.auth.uid || roleIsManager()))
        // the manager's three words
        || (to in ['returned', 'approved', 'rejected'] && from == 'pendingApproval' && roleIsManager())
        // turning an approved request into orders: anyone who may place an order
        || (to == 'poCreated' && from == 'approved')
        // reopening a decision: admin only
        || (to == 'pendingApproval' && from in ['approved', 'rejected'] && roleIsAdmin())
      );
    }

    function movementEdit() {
      return editedKeys().hasOnly([
          'qty', 'date', 'note', 'unit', 'entryUnit', 'fromLocationId', 'toLocationId',
          'edits', 'updatedBy', 'updatedByName', 'updatedAt', 'voided'
        ])
        && (!editedKeys().hasAny(['voided']) || roleIsAdmin())
        && (!('updatedBy' in request.resource.data)
            || request.resource.data.updatedBy == request.auth.uid)
        // Changing what a row says means appending to its history, in the caller's own name.
        // `unit` is here because correcting a product's unit restamps every row filed under
        // the old one, and that is an edit like any other: it signs itself.
        && (!editedKeys().hasAny(['qty', 'date', 'note', 'unit', 'entryUnit',
                                  'fromLocationId', 'toLocationId'])
            || appendedOwnEdit());
    }

    /**
     * The edit history grew by exactly one entry, and that entry names the caller.
     *
     * This is the anti-fraud control the owner asked for, and it is worth being plain about
     * its edge: rules cannot compare two lists element by element, so what is proved here is
     * that an edit cannot be filed under a colleague's name and cannot quietly shrink the
     * history. A determined admin calling the database directly could still rewrite earlier
     * entries; catching that needs a trusted server comparing writes, which the free plan has
     * no room for. The same limit already applies to balances, and for the same reason.
     */
    function appendedOwnEdit() {
      // Read with a default: a write that omits the history entirely must be refused, not
      // crash the rule. Omitting it is exactly how someone would try to edit anonymously.
      let next = request.resource.data.get('edits', null);
      let prev = resource.data.get('edits', []);
      return next is list
        && next.size() == prev.size() + 1
        && next.size() <= 200
        && next[next.size() - 1].by == request.auth.uid;
    }

    // ---------------------------------------------------------------- users ----

    match /users/{uid} {
      // Everyone loads their own profile on sign-in; only admins can see the roster.
      allow get: if authed() && (uid == request.auth.uid || admin());
      allow list: if admin();

      // Two legitimate ways a profile appears:
      //  - an admin adds someone, with any role, active straight away;
      //  - a person signs themselves up, which must produce an INACTIVE STAFF account.
      // Self-signup can NEVER produce an admin, and never resurrects a revoked account.
      // There is deliberately no "first caller becomes the owner" path: on an empty
      // database nobody can create a profile, and the owner is provisioned out of band
      // (Firebase console) where rules do not apply. Whoever holds the public API key is
      // not evidence of ownership.
      // A revoked uid gets no profile from anyone, admin included, until the revocation is
      // lifted first. Otherwise an admin could re-add someone and hand them a profile that
      // the revocation check still silently blocks.
      allow create: if !revoked(uid) && (
        admin()
        || (uid == request.auth.uid
            && request.resource.data.role == 'staff'
            && request.resource.data.active == false)
      );

      // role and active ARE the access model — only an admin may change a profile, and an
      // admin may not change their own, so the last admin cannot lock the database's only
      // way back in. Renaming yourself is still fine.
      allow update: if admin() && (
        uid != request.auth.uid
        || (request.resource.data.role == resource.data.role
            && request.resource.data.active == resource.data.active)
      );

      // Deleting your own profile would lock you out of your own database. The tombstone
      // has to exist first, so a removal can never be a profile deletion on its own — the
      // auth account behind it would just sign up again.
      allow delete: if admin() && uid != request.auth.uid && revoked(uid);
    }

    // ---------------------------------------------------------------- bootstrap ----

    // Marker saying this database has been provisioned. The app reads it to tell "nobody
    // has set this up yet" apart from "your account is waiting for approval". No client
    // may write it: it is created alongside the first admin from the Firebase console.
    match /meta/bootstrap {
      allow get: if authed();
      allow write: if false;
    }

    // ---------------------------------------------------------------- entry units ----

    // The words a quantity may be keyed in — Lot, Pack, Carton — maintained by an admin in
    // Settings. One shared document rather than a collection: the list is a dozen short
    // words, and a collection would be charged one read per name every time anyone opened
    // a receiving screen. Shared across brands because a carton is a carton in either.
    //
    // These are labels, not conversions, so nothing here can change a recorded quantity: a
    // movement stores a number in the product's own unit and never this string. The worst a
    // bad list can do is put a silly word in a dropdown.
    match /meta/entryUnits {
      allow get: if active();
      allow create, update: if admin() && validUnitList(request.resource.data);
      // Emptying the dropdown is not an edit anyone needs; shortening it is.
      allow delete: if false;
    }

    // ---------------------------------------------------------------- revocation ----

    // One document per removed account, keyed by uid. Admins add and (to re-hire someone)
    // remove them; nobody can lift their own.
    match /revokedUsers/{uid} {
      allow read: if admin();
      allow create, delete: if admin() && uid != request.auth.uid;
      allow update: if false;
    }

    // ---------------------------------------------------------------- brand data ----

    // One block for every brand-scoped collection. Anything not named by the functions
    // above — including /meta and any collection a client invents — falls through to
    // Firestore's default deny.
    match /{collection}/{docId} {
      allow read: if active() && brandData(collection);

      // Who may write, and separately, what a written document is allowed to look like.
      // Type and range checks belong here as well as in the services, because the services
      // are client code: a caller holding a token skips them entirely.
      allow create: if writer(collection)
        && validShape(collection, docId, request.resource.data, true)
        && createdHonestly(collection);

      allow update: if writer(collection)
        && validShape(collection, docId, request.resource.data, false)
        && editedHonestly(collection);

      allow delete: if active() && staffDeletable(collection);
      allow delete: if admin() && brandData(collection) && !ledger(collection)
        && !receivedOrder(collection);
    }
  }
}
