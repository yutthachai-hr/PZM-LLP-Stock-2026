# Loaded by `vite --mode e2e` — the Playwright tests (npm run test:e2e) only.
#
# Points the app at the local Firebase emulators under the `demo-pzm-e2e` project, never at
# the live pzm-stock-x5 one: src/firebase/config.ts honours this only on localhost.
# Nothing here is secret.
VITE_USE_EMULATOR=1
# Every stock command goes through the trusted server (ADR-001) — e2e/command-server.mjs
# answers them over the emulator — so the scenarios test the server path.
VITE_STOCK_COMMANDS=all
