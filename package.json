{
  "name": "pizza-stock",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --mode demo",
    "dev:live": "vite",
    "demo": "vite --mode demo --port 5175 --strictPort",
    "dev:e2e": "vite --mode e2e --port 5176 --strictPort",
    "build": "tsc -b && tsc -p functions/tsconfig.json && tsc -p worker/tsconfig.json && tsc -p e2e/tsconfig.json && vite build",
    "worker:dev": "npx wrangler dev -c worker/wrangler.toml --test-scheduled",
    "worker:deploy": "npx wrangler deploy -c worker/wrangler.toml",
    "lint": "oxlint",
    "import-items": "node scripts/import-items.mjs",
    "i18n:check": "node --experimental-strip-types scripts/i18n-check.mjs",
    "ux-lab": "node --experimental-strip-types scripts/ux-lab/cli.mjs",
    "audit:integrity": "node scripts/integrity-audit.mjs",
    "shadow": "node scripts/shadow.mjs",
    "backfill:po-baseqty": "node scripts/backfill-po-baseqty.mjs",
    "test:rules": "firebase emulators:exec --only firestore --project pzm-rules-test \"vitest run --config vitest.rules.config.ts\"",
    "test:e2e": "firebase emulators:exec --only firestore,auth --project demo-pzm-e2e \"playwright test\"",
    "build:demo": "vite build --mode demo --outDir dist-demo",
    "preview": "vite preview --outDir dist-demo",
    "preview:live": "vite preview",
    "test": "vitest run",
    "icons": "node scripts/make-icons.mjs",
    "check:bundle": "node scripts/bundle-budget.mjs",
    "intel:backtest": "node scripts/intel-backtest.mjs",
    "safety:dataset": "node scripts/safety-dataset.mjs",
    "safety:bench": "node scripts/safety-bench.mjs",
    "integrity:vectors": "node scripts/integrity-vectors.mjs",
    "integrity:bench": "node --expose-gc scripts/integrity-bench.mjs",
    "verify": "node scripts/verify.mjs",
    "laya:bench": "node scripts/laya-bench.mjs"
  },
  "dependencies": {
    "@line/liff": "^2.31.0",
    "@zxing/browser": "^0.2.1",
    "dayjs": "^1.11.21",
    "firebase": "^12.16.0",
    "html2canvas": "^1.4.1",
    "jose": "^6.2.12",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.3",
    "recharts": "^3.9.2",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@cloudflare/workers-types": "^5.20260915.1",
    "@electric-sql/pglite": "^0.3.16",
    "@firebase/rules-unit-testing": "^5.0.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.2",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "firebase-tools": "^15.24.0",
    "oxlint": "^1.71.0",
    "postgres": "^3.4.9",
    "tailwindcss": "^4.3.2",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.0"
  }
}
